{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/NeverWe1come/KMIPKit/main/ide-plugins/schemas/kmip-policy.schema.json",
  "title": "KMIPKit Cryptographic Policy & Template",
  "description": "Schema for validating KMIP cryptographic templates and NIST/enterprise policy rules (*.kmip-policy.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyName", "allowedAlgorithms", "minimumKeyLengths"],
  "properties": {
    "$schema": { "type": "string" },
    "policyName": { "type": "string", "minLength": 1 },
    "minKmipVersion": {
      "type": "string",
      "enum": ["1.2", "1.4", "2.0", "2.1", "3.0"],
      "default": "2.1"
    },
    "allowedAlgorithms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "AES", "RSA", "ECDSA", "ECDH", "HMAC-SHA256", "HMAC-SHA384", "HMAC-SHA512",
          "ChaCha20Poly1305", "ML-KEM", "ML-DSA", "SLH-DSA"
        ]
      }
    },
    "forbiddenAlgorithms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["DES", "3DES", "RC4", "MD5", "SHA-1", "DSA"]
      },
      "default": ["DES", "3DES", "RC4", "MD5", "SHA-1"]
    },
    "minimumKeyLengths": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 128 },
      "properties": {
        "AES": { "type": "integer", "minimum": 128, "default": 256 },
        "RSA": { "type": "integer", "minimum": 2048, "default": 3072 },
        "ECDSA": { "type": "integer", "minimum": 256, "default": 256 }
      }
    },
    "requireLifecycleGuard": {
      "type": "boolean",
      "default": true
    }
  }
}
