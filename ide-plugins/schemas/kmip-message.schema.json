{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/NeverWe1come/KMIPKit/main/ide-plugins/schemas/kmip-message.schema.json",
  "title": "KMIP Message JSON Representation",
  "description": "Schema for OASIS KMIP RequestMessage and ResponseMessage documents (*.kmip.json).",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    { "required": ["RequestMessage"] },
    { "required": ["ResponseMessage"] }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "RequestMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["RequestHeader", "BatchItem"],
      "properties": {
        "RequestHeader": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ProtocolVersion"],
          "properties": {
            "ProtocolVersion": { "$ref": "#/definitions/ProtocolVersion" },
            "MaximumResponseSize": { "type": "integer", "minimum": 1 },
            "BatchCount": { "type": "integer", "minimum": 1 },
            "AsynchronousIndicator": { "type": "boolean" },
            "Authentication": { "type": "object" }
          }
        },
        "BatchItem": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["Operation"],
            "properties": {
              "Operation": { "$ref": "#/definitions/Operation" },
              "UniqueBatchItemID": { "type": "string" },
              "RequestPayload": { "type": "object" }
            }
          }
        }
      }
    },
    "ResponseMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ResponseHeader", "BatchItem"],
      "properties": {
        "ResponseHeader": {
          "type": "object",
          "required": ["ProtocolVersion", "TimeStamp", "BatchCount"],
          "properties": {
            "ProtocolVersion": { "$ref": "#/definitions/ProtocolVersion" },
            "TimeStamp": { "type": "string" },
            "BatchCount": { "type": "integer", "minimum": 1 }
          }
        },
        "BatchItem": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ResultStatus"],
            "properties": {
              "Operation": { "$ref": "#/definitions/Operation" },
              "ResultStatus": {
                "type": "string",
                "enum": ["Success", "OperationFailed", "OperationPending", "OperationUndone"]
              },
              "ResultReason": { "type": "string" },
              "ResultMessage": { "type": "string" },
              "ResponsePayload": { "type": "object" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ProtocolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ProtocolVersionMajor", "ProtocolVersionMinor"],
      "properties": {
        "ProtocolVersionMajor": { "type": "integer", "enum": [1, 2, 3] },
        "ProtocolVersionMinor": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    },
    "Operation": {
      "type": "string",
      "enum": [
        "Create", "CreateKeyPair", "Register", "ReKey", "DeriveKey",
        "Certify", "ReCertify", "Locate", "Check", "Get",
        "GetAttributes", "GetAttributeList", "AddAttribute", "ModifyAttribute",
        "DeleteAttribute", "ObtainLease", "GetUsageAllocation", "Activate",
        "Revoke", "Destroy", "Archive", "Recover", "Validate", "Query",
        "Cancel", "Poll", "Notify", "Put", "ReKeyKeyPair", "DiscoverVersions",
        "Encrypt", "Decrypt", "Sign", "SignatureVerify", "MAC", "MACVerify",
        "Hash", "CreateSplitKey", "JoinSplitKey", "Import", "Export",
        "CreateUser", "DeleteUser", "Obliterate", "Encapsulate", "Decapsulate",
        "Ping", "SetAttribute", "AdjustAttribute", "ArchiveRecover"
      ]
    }
  }
}
