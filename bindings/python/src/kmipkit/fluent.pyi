    def set_constraints(self, constraints: ttlv.Structure | None = ...) -> SetConstraintsBuilder: ...
    def log(
        self, log_message: str | bytes | bytearray | memoryview | None = ...
    ) -> LogBuilder: ...

class CreateCredentialObject:
    """Closed, native-owned Create Credential alternative; close it after use."""
    @classmethod
    def certificate(cls, certificate: ttlv.TtlvItem) -> CreateCredentialObject: ...
    @classmethod
    def password(
        cls, *, password: SecretText | None = ..., password_salt: SecretBytes | None = ...,
        password_salt_algorithm: int | None = ..., salted_password: SecretBytes | None = ...,
        iteration_count: int | None = ...,
    ) -> CreateCredentialObject: ...
    @classmethod
    def device(
        cls, *, serial_number: str | None = ..., device_identifier: str | None = ...,
        network_identifier: str | None = ..., machine_identifier: str | None = ...,
        media_identifier: str | None = ...,
    ) -> CreateCredentialObject: ...
    @classmethod
    def hashed_password(
        cls, hashed_username_password: SecretBytes, hashed_password_username: SecretBytes,
        *, hashing_algorithm: int | None = ...,
    ) -> CreateCredentialObject: ...
    @classmethod
    def one_time_password(
        cls, algorithm: int, *, digest: int | None = ..., serial: str | None = ...,
        seed: SecretBytes | None = ..., interval: int | None = ..., digits: int | None = ...,
    ) -> CreateCredentialObject: ...
    def close(self) -> None: ...

