    def get_constraints(self) -> GetConstraintsBuilder: ...
    def cancel(
        self, correlation_value: bytes | bytearray | memoryview | None = ...
    ) -> CancelBuilder: ...
    def poll(
        self, correlation_value: bytes | bytearray | memoryview | None = ...
    ) -> PollBuilder: ...
    def process(
        self, correlation_value: bytes | bytearray | memoryview | None = ...
    ) -> ProcessBuilder: ...
