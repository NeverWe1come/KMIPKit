# Production Doxygen configuration for KMIPKit C11 ABI (bindings/c/Doxyfile)

PROJECT_NAME           = "KMIPKit C ABI"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Stable C11 ABI for OASIS KMIP 2.0, 2.1, and 3.0"
OUTPUT_DIRECTORY       = build/doxygen

INPUT                  = include/kmipkit.h \
                         include/kmipkit_fluent.h \
                         docs/doxygen_mainpage.h
FILE_PATTERNS          = *.h
RECURSIVE              = NO

# C-specific optimization
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
SORT_MEMBER_DOCS       = YES

# Strict CI quality gates
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES

# Outputs
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
