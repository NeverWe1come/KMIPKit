{
  "format": "kmipkit-extension-fixtures",
  "formatVersion": 1,
  "outcomeEncoding": {
    "version": 1,
    "outcomeCodes": [
      "recognized",
      "unrecognized.schema_invalid",
      "unrecognized.ambiguous",
      "unrecognized.no_match",
      "outbound.validated"
