    "matchedDefinitionIdsOrder": "lexicographic-ascending",
    "genericPayloadRepresentation": "normalized-ttlv-v1",
    "arrayOrder": "significant-and-preserved"
  },
  "definitions": [
    {
      "id": "ambiguous.beta",
      "vendorIdentification": "example.vendor",
      "extensionName": "ambiguous-beta",
      "extensionVersion": "1",
      "discriminator": {
        "path": ["0x540010", "0x540012"],
        "itemType": "TextString",
        "value": "route-beta"
      },
      "payloadSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Beta definition schema for the shared ambiguous payload",
        "type": "object",
        "required": ["type", "children"],
        "properties": {
          "type": {"const": "Structure"},
          "children": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["tag", "type", "children"],
              "properties": {
                "tag": {"const": "0x540010"},
                "type": {"const": "Structure"},
                "children": {
                  "type": "array",
                  "allOf": [
                    {"contains": {"type": "object", "required": ["tag", "type", "value"], "properties": {"tag": {"const": "0x540011"}, "type": {"const": "TextString"}, "value": {"const": "route-alpha"}}}},
                    {"contains": {"type": "object", "required": ["tag", "type", "value"], "properties": {"tag": {"const": "0x540012"}, "type": {"const": "TextString"}, "value": {"const": "route-beta"}}}},
                    {"contains": {"type": "object", "required": ["tag", "type", "value"], "properties": {"tag": {"const": "0x540013"}, "type": {"const": "TextString"}, "value": {"const": "shared"}}}}
                  ]
                }
              }
            }
          }
        }
      }
    },
