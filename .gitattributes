* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.dll binary
*.lib binary
*.so binary
*.dylib binary
*.a binary

# Preserve pinned upstream standards byte-for-byte for checksum verification.
specification/oasis/**/upstream/* -text -diff

# Preserve linked OASIS test-case XML fixtures byte-for-byte for checksum verification.
specification/oasis/**/fixtures/*.xml -text -diff

# Preserve upstream vendor whitespace without formatting the imported source.
vendor/aws-lc-sys-0.45.0/** whitespace=-trailing-space,-blank-at-eof,-space-before-tab
