crates/kmipkit-protocol/src/attribute_types_generated.rs text eol=lf
crates/kmipkit-protocol/src/typed_attributes_generated.rs text eol=lf
crates/kmipkit-client/src/wire_names_generated.rs text eol=lf
crates/kmipkit-ffi/src/extension_registry/typed_attributes_catalog_generated.rs text eol=lf
bindings/c/include/kmipkit_standard_attributes_generated.h text eol=lf
bindings/java/src/main/java/org/kmipkit/ttlv/StandardAttribute.java text eol=lf
bindings/python/src/kmipkit/_generated/standard_attribute.py text eol=lf
crates/kmipkit-client/src/attribute_tags_generated.rs text eol=lf
