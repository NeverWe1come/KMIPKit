# Keep pinned OASIS documents and official vectors byte-for-byte on every platform.
# These upstream artifacts are reviewed through source inventories and checksums.
verification/conformance/oasis/**/upstream/* -text -diff
verification/conformance/oasis/**/fixtures/*.xml -text -diff

