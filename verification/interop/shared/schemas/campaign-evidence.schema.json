{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KMIPKit campaign evidence",
  "type": "object",
  "required": ["schema_version", "run_id", "scope", "language", "library_commit", "artifact_sha256", "matrix_sha256", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scope": { "enum": ["local", "controlled", "live"] },
    "language": { "enum": ["rust", "c", "java", "python"] },
    "library_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact_sha256": { "$ref": "#/$defs/sha256" },
    "matrix_sha256": { "$ref": "#/$defs/sha256" },
    "server": {
      "type": "object",
      "required": ["id", "product", "version", "configuration_fingerprint"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "product": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "configuration_fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["obligation_id", "status", "public_api_symbol"],
        "additionalProperties": false,
        "dependentRequired": {
          "parity_group": ["semantic_sha256"],
          "semantic_sha256": ["parity_group"]
        },
        "properties": {
          "obligation_id": { "$ref": "#/$defs/sha256" },
          "status": { "enum": ["passed", "failed", "blocked"] },
          "public_api_symbol": { "type": "string", "minLength": 1 },
          "execution_api_symbol": { "type": "string", "minLength": 1 },
          "parity_group": { "$ref": "#/$defs/sha256" },
          "semantic_sha256": { "$ref": "#/$defs/sha256" },
          "encoding": { "enum": ["TTLV", "JSON", "XML"] },
          "transport": { "enum": ["raw_tls", "https"] },
          "result_status_code": { "$ref": "#/$defs/wire_code" },
          "result_reason_code": { "$ref": "#/$defs/wire_code" },
          "server_compatibility": { "enum": ["supported", "unsupported", "expected_rejection", "policy_restricted", "unknown"] },
          "assertion": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$" }
        }
      }
    }
  },
  "if": { "properties": { "scope": { "const": "live" } } },
  "then": { "required": ["server"] },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "wire_code": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
  }
}
