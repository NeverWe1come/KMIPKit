{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmipkit.org/schemas/test-catalog.schema.json",
  "title": "Versioned KMIP 2.0 and 2.1 Executable Test Catalog",
  "type": "object",
  "required": ["version", "target_versions", "capability_policy", "execution_policy", "statistics", "normative_targets", "test_cases"],
  "properties": {
    "version": { "type": "string" },
    "catalog_source": { "type": "string" },
    "target_versions": {
      "type": "array",
      "items": { "enum": ["2.0", "2.1"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "capability_policy": { "const": "probe_all_applicable" },
    "execution_policy": {
      "type": "object",
      "required": ["requires_dedicated_test_environment", "mutating_cases_require_explicit_enablement", "never_retry_requests"],
      "properties": {
        "requires_dedicated_test_environment": { "const": true },
        "mutating_cases_require_explicit_enablement": { "const": true },
        "never_retry_requests": { "const": true }
      },
      "additionalProperties": false
    },
    "statistics": {
      "type": "object",
      "required": ["operations_covered", "server_to_client_operations_covered", "managed_objects_covered", "attributes_covered", "batch_scenarios", "asynchronous_scenarios", "exhaustive_bitmask_families", "normative_targets", "total_cases"],
      "properties": {
        "operations_covered": { "type": "integer", "minimum": 0 },
        "server_to_client_operations_covered": { "type": "integer", "minimum": 0 },
        "managed_objects_covered": { "type": "integer", "minimum": 0 },
        "attributes_covered": { "type": "integer", "minimum": 0 },
        "enumerations_covered": { "type": "integer", "minimum": 0 },
        "bitmasks_covered": { "type": "integer", "minimum": 0 },
        "batch_scenarios": { "type": "integer", "minimum": 0 },
        "asynchronous_scenarios": { "type": "integer", "minimum": 0 },
        "exhaustive_bitmask_families": { "type": "integer", "minimum": 0 },
        "normative_targets": { "type": "integer", "minimum": 1 },
        "total_cases": { "type": "integer", "minimum": 1 }
      }
    },
    "normative_targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/normativeTarget" }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "category", "operation", "requires", "isolation_recipe", "normative_refs", "execution"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "category": {
            "enum": ["protocol_and_session", "object_lifecycle", "server_initiated_operations", "managed_objects", "attributes", "cryptography_and_rng", "enums_and_bitmasks", "normative_inventory", "batch_workflows", "multipart_crypto", "asynchronous_workflows", "negative_and_boundary", "version_boundaries"]
          },
          "operation": { "type": "string", "minLength": 1 },
          "oasis_section": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "normative_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["document", "section"],
              "properties": {
                "document": { "enum": ["OASIS KMIP 2.0 Specification", "OASIS KMIP 2.1 Specification"] },
                "section": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
                "table": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "requires": {
            "type": "object",
            "properties": {
              "normative_target_id": { "type": "string", "pattern": "^KMIPKIT-(?:ELEM-[A-Z0-9-]+|RANGE-[0-9]+|PAYLOAD-[A-Z0-9-]+|PKCS11-[A-Z0-9-]+)$" },
              "normative_target_ids": { "type": "array", "items": { "type": "string", "pattern": "^KMIPKIT-(?:ELEM-[A-Z0-9-]+|RANGE-[0-9]+|PAYLOAD-[A-Z0-9-]+|PKCS11-[A-Z0-9-]+)$" }, "minItems": 1, "uniqueItems": true },
              "target_kind": { "type": "string", "minLength": 1 },
              "target_protocol_versions": {
                "type": "array",
                "items": { "enum": ["2.0", "2.1"] },
                "minItems": 1,
                "uniqueItems": true
              },
              "wire_value": { "type": "string", "minLength": 1 },
              "boundary_vector_file": { "const": "interop/shared/vectors/ttlv-boundaries.json" },
              "attribute_policy": { "$ref": "#/$defs/attributePolicy" },
              "source_encoding": { "type": "string", "minLength": 1 },
              "source_requiredness": { "type": "string" },
              "branch_classes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
              "expected_result_reasons": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "minItems": 1,
                "uniqueItems": true
              },
              "protocol_scenario": { "$ref": "#/$defs/protocolScenario" },
              "exhaustive_bitmask_combinations": { "$ref": "#/$defs/exhaustiveBitmaskCombinations" }
            },
            "additionalProperties": true
          },
          "isolation_recipe": {
            "type": "object",
            "required": ["unique_name_prefix", "setup_steps", "target_step", "teardown_steps"],
            "properties": {
              "unique_name_prefix": { "type": "string" },
              "setup_steps": { "type": "array", "items": { "type": "string" } },
              "target_step": { "type": "string" },
              "teardown_steps": { "type": "array", "items": { "type": "string" } },
              "normalized_fields": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          },
          "execution": {
            "type": "object",
            "required": ["mode", "protocol_versions", "steps", "assertions", "mutation", "status"],
            "properties": {
              "mode": { "enum": ["server_exchange", "local_model"] },
              "protocol_versions": {
                "type": "array",
                "items": { "enum": ["2.0", "2.1"] },
                "minItems": 1,
                "uniqueItems": true
              },
              "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "assertions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "mutation": { "enum": ["read_only", "mutating"] },
              "status": { "enum": ["planned", "implemented", "not_applicable"] },
              "not_applicable_reason": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "status": { "const": "not_applicable" } } },
                "then": { "required": ["not_applicable_reason"] }
              }
            ],
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": { "properties": { "category": { "const": "attributes" } } },
            "then": { "properties": { "requires": { "required": ["attribute", "attribute_policy"] } } }
          },
          {
            "if": { "properties": { "category": { "const": "normative_inventory" } } },
            "then": { "properties": { "requires": { "required": ["normative_target_id", "target_kind", "target_protocol_versions"] } } }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "exhaustiveBitmaskCombinations": {
      "type": "object",
      "required": ["flag_target_ids", "flag_wire_values", "combination_count", "algorithm", "includes_zero", "unknown_bits_tested_separately"],
      "properties": {
        "flag_target_ids": { "type": "array", "items": { "type": "string", "pattern": "^KMIPKIT-ELEM-[A-Z0-9-]+$" }, "minItems": 1, "uniqueItems": true },
        "flag_wire_values": { "type": "array", "items": { "type": "string", "pattern": "^[0-9A-Fa-f]{8}$" }, "minItems": 1, "uniqueItems": true },
        "combination_count": { "type": "integer", "minimum": 1 },
        "algorithm": { "const": "OR every subset of the assigned flag values" },
        "includes_zero": { "const": true },
        "unknown_bits_tested_separately": { "const": true }
      },
      "additionalProperties": false
    },
    "protocolScenario": {
      "type": "object",
      "required": ["scenario_id", "target_ids", "operations", "protocol_versions", "parameters", "expected", "mode", "mutation", "steps", "assertions", "normative_refs"],
      "properties": {
        "scenario_id": { "type": "string", "minLength": 1 },
        "target_ids": { "type": "array", "items": { "type": "string", "pattern": "^KMIPKIT-(?:ELEM-[A-Z0-9-]+|RANGE-[0-9]+|PAYLOAD-[A-Z0-9-]+|PKCS11-[A-Z0-9-]+)$" }, "minItems": 1, "uniqueItems": true },
        "operations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "protocol_versions": { "type": "array", "items": { "enum": ["2.0", "2.1"] }, "minItems": 1, "uniqueItems": true },
        "parameters": { "type": "object" },
        "expected": { "type": "object" },
        "mode": { "enum": ["server_exchange", "local_model"] },
        "mutation": { "enum": ["read_only", "mutating"] },
        "steps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "assertions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "normative_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["document", "section"],
            "properties": {
              "document": { "enum": ["OASIS KMIP 2.0 Specification", "OASIS KMIP 2.1 Specification"] },
              "section": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
              "table": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "normativeTarget": {
      "type": "object",
      "required": ["target_id", "kind", "name", "protocol_versions", "source_refs"],
      "properties": {
        "target_id": { "type": "string", "pattern": "^KMIPKIT-(?:ELEM-[A-Z0-9-]+|RANGE-[0-9]+|PAYLOAD-[A-Z0-9-]+|PKCS11-[A-Z0-9-]+)$" },
        "kind": { "enum": ["operation", "object_type", "attribute", "tag", "tag_range", "enumeration_value", "referenced_enum_value", "bitmask_value", "data_type", "message_field", "structure_member", "operation_structure", "object_structure", "attribute_structure", "credential", "operation_payload_field", "operation_payload_value_variant"] },
        "name": { "type": "string", "minLength": 1 },
        "parent_name": { "type": "string", "minLength": 1 },
        "attribute_policy": { "$ref": "#/$defs/attributePolicy" },
        "protocol_versions": {
          "type": "array",
          "items": { "enum": ["2.0", "2.1"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "anyOf": [{ "required": ["section"] }, { "required": ["artifact", "sha256"] }],
            "properties": {
              "document": { "type": "string", "minLength": 1 },
              "section": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
              "table": { "type": "string", "minLength": 1 },
              "artifact": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "wire_value": { "type": "string", "minLength": 1 },
        "allocation": { "enum": ["assigned", "reserved", "extension", "unused"] },
        "source_encoding": { "type": "string", "minLength": 1 },
        "source_requiredness": { "type": "string" },
        "parent_element_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "operation_id": { "type": "string", "pattern": "^KMIPKIT-ELEM-OP-[A-Z0-9-]+$" },
        "operation": { "type": "string", "minLength": 1 },
        "parent_target_id": { "type": "string", "minLength": 1 },
        "field_name": { "type": "string", "minLength": 1 },
        "value_type": { "type": "string", "enum": ["Structure", "Integer", "Long Integer", "Big Integer", "Enumeration", "Boolean", "Text String", "Byte String", "Date Time", "Interval", "Date Time Extended"] },
        "value_type_alternatives": { "type": "array", "items": { "type": "string", "enum": ["Structure", "Integer", "Long Integer", "Big Integer", "Enumeration", "Boolean", "Text String", "Byte String", "Date Time", "Interval", "Date Time Extended"] }, "minItems": 1, "uniqueItems": true },
        "direction": { "enum": ["client_to_server", "server_to_client"] },
        "role": { "enum": ["request", "response"] },
        "row_index": { "type": "integer", "minimum": 1 },
        "requiredness": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "branch_classes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "presence_branches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["condition", "presence"],
            "properties": {
              "condition": { "type": "string", "minLength": 1 },
              "presence": { "enum": ["required", "optional", "prohibited", "recommended"] }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "attributePolicy": {
      "type": "object",
      "required": ["value_type", "initially_set_by", "modifiable_by_client", "deletable_by_client", "always_required", "multiple_instances_permitted", "policy_table", "conditional_rules", "operation_restrictions", "branch_classes"],
      "properties": {
        "value_type": { "type": ["string", "null"] },
        "initially_set_by": { "type": ["string", "null"] },
        "modifiable_by_client": { "type": ["string", "null"] },
        "deletable_by_client": { "type": ["string", "null"] },
        "always_required": { "type": ["string", "null"] },
        "multiple_instances_permitted": { "type": ["string", "null"] },
        "policy_table": { "type": ["string", "null"] },
        "conditional_rules": { "type": "array", "items": { "type": "string" } },
        "operation_restrictions": { "type": "array", "items": { "type": "string" } },
        "branch_classes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  }
}
