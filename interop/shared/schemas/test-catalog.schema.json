{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmipkit.org/schemas/test-catalog.schema.json",
  "title": "KMIP 2.1 Test Catalog Schema",
  "type": "object",
  "required": ["version", "statistics", "test_cases"],
  "properties": {
    "version": { "type": "string" },
    "catalog_source": { "type": "string" },
    "statistics": {
      "type": "object",
      "required": ["operations_covered", "managed_objects_covered", "attributes_covered", "total_cases"],
      "properties": {
        "operations_covered": { "type": "integer" },
        "managed_objects_covered": { "type": "integer" },
        "attributes_covered": { "type": "integer" },
        "total_cases": { "type": "integer" }
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "category", "operation", "requires", "isolation_recipe"],
        "properties": {
          "case_id": { "type": "string" },
          "category": { "type": "string" },
          "operation": { "type": "string" },
          "oasis_section": { "type": "string" },
          "description": { "type": "string" },
          "requires": {
            "type": "object",
            "properties": {
              "operation": { "type": "string" },
              "object_type": { "type": "string" },
              "algorithm": { "type": "string" },
              "key_length": { "type": "integer" },
              "curve": { "type": "string" },
              "attribute": { "type": "string" },
              "attribute_op": { "type": "string" },
              "requires_async": { "type": "boolean" },
              "enum_type": { "type": "string" },
              "bitmask_type": { "type": "string" },
              "workflow_type": { "type": "string" },
              "vector_ref": { "type": "string" },
              "expected_status": { "type": "string" }
            }
          },
          "isolation_recipe": {
            "type": "object",
            "required": ["unique_name_prefix", "teardown_steps"],
            "properties": {
              "unique_name_prefix": { "type": "string" },
              "setup_steps": { "type": "array", "items": { "type": "string" } },
              "target_step": { "type": "string" },
              "teardown_steps": { "type": "array", "items": { "type": "string" } },
              "normalized_fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
