{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmipkit.org/schemas/route-execution-evidence.schema.json",
  "title": "KMIPKit Independent Consumer Route Execution Evidence",
  "type": "object",
  "required": ["schema_version", "run_id", "language", "server", "library_commit", "artifact_sha256", "catalog_sha256", "route_manifest_sha256", "protocol_versions", "network_combinations", "events"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "language": { "enum": ["rust", "c", "java", "python"] },
    "server": {
      "type": "object",
      "required": ["id", "product", "version", "configuration_fingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "product": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "configuration_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "library_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "catalog_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "route_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "protocol_versions": { "type": "array", "items": { "enum": ["2.0", "2.1"] }, "minItems": 1, "uniqueItems": true },
    "network_combinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["encoding", "transport"],
        "properties": {
          "encoding": { "enum": ["TTLV", "JSON", "XML"] },
          "transport": { "enum": ["raw_tls", "https"] }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } }
  },
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": ["case_id", "route_id", "target_id", "public_api_symbol", "execution_route_id", "execution_api_symbol", "invocation_id", "action", "protocol_version", "encoding", "transport", "status", "invocation_count"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "route_id": { "type": "string", "minLength": 1 },
        "target_id": { "type": "string", "minLength": 1 },
        "workflow_step_index": { "type": "integer", "minimum": 0 },
        "workflow_operation": { "type": "string", "minLength": 1 },
        "workflow_item_index": { "type": "integer", "minimum": 0 },
        "public_api_symbol": { "type": "string", "minLength": 1 },
        "execution_route_id": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "execution_api_symbol": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "invocation_id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["construct", "encode", "send", "decode"] },
        "protocol_version": { "enum": ["2.0", "2.1"] },
        "encoding": { "enum": ["TTLV", "JSON", "XML"] },
        "transport": { "oneOf": [{ "type": "null" }, { "enum": ["raw_tls", "https"] }] },
        "status": { "enum": ["passed", "failed", "not_run"] },
        "invocation_count": { "const": 1 },
        "request_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "response_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "wire_bytes_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "wire_bytes_deterministic": { "type": "boolean" },
        "batch_operation_sequence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2 },
        "peer_observed_operation_sequence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2 },
        "batch_item_count": { "type": "integer", "minimum": 2 },
        "peer_observed_response_count": { "type": "integer", "minimum": 1 },
        "peer_observed_result_status_codes": {
          "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "minItems": 1
        },
        "peer_observed_result_reason_codes": {
          "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "minItems": 1
        },
        "peer_observed_effects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "not_run_reason": { "type": "string", "minLength": 1 },
        "failure_code": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not_run" } } },
          "then": { "required": ["not_run_reason"] }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } } },
          "then": { "required": ["failure_code"] }
        },
        {
          "if": { "properties": { "status": { "const": "passed" }, "action": { "const": "decode" } } },
          "then": { "required": ["response_tree_sha256"] }
        },
        {
          "if": { "properties": { "status": { "const": "passed" }, "action": { "enum": ["construct", "encode", "send"] } } },
          "then": { "required": ["request_tree_sha256"] }
        },
        {
          "if": { "properties": { "wire_bytes_deterministic": { "const": true } },
                  "required": ["wire_bytes_deterministic"] },
          "then": { "required": ["wire_bytes_sha256"] }
        },
        {
          "if": { "required": ["batch_item_count"] },
          "then": { "required": ["batch_operation_sequence"] }
        },
        {
          "if": { "properties": { "status": { "const": "passed" } }, "required": ["batch_item_count"] },
          "then": { "required": ["peer_observed_operation_sequence", "peer_observed_response_count"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
