{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmipkit.org/schemas/server-connection.schema.json",
  "title": "KMIP Server Connection Configuration",
  "type": "object",
  "required": ["server_id", "server_product", "server_version", "server_configuration_fingerprint", "protocol_version", "transport", "encoding", "api_level", "endpoints", "environment", "execution_policy"],
  "properties": {
    "server_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "server_vendor": { "type": "string" },
    "server_product": { "type": "string", "minLength": 1 },
    "server_version": { "type": "string", "minLength": 1 },
    "server_configuration_fingerprint": {
      "type": "string",
      "description": "Stable SHA-256 fingerprint of one deployed server configuration, independent of client transport, encoding, API level, and protocol version.",
      "pattern": "^[a-f0-9]{64}$"
    },
    "server_product": {
      "type": "string",
      "minLength": 1,
      "description": "Optional operator-verified product label for report metadata; a capability profile is not evidence."
    },
    "server_version": {
      "type": "string",
      "minLength": 1,
      "description": "Optional operator-verified server release; do not use the negotiated KMIP protocol version here."
    },
    "description": {
      "type": "string"
    },
    "protocol_version": { "enum": ["2.0", "2.1"] },
    "transport": { "enum": ["raw_tls", "https"] },
    "encoding": { "enum": ["TTLV", "JSON", "XML"] },
    "api_level": { "enum": ["high-level", "typed-protocol", "generic-ttlv"] },
    "endpoints": {
      "type": "object",
      "properties": {
        "raw_tls": {
          "type": "object",
          "required": ["host", "port"],
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "https": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "ca_cert_path": { "type": "string" },
        "client_cert_path": { "type": "string" },
        "client_key_path": { "type": "string" },
        "server_name_override": { "type": "string" },
        "connect_timeout_seconds": { "type": "integer", "default": 10 },
        "read_timeout_seconds": { "type": "integer", "default": 30 }
      }
    },
    "authentication": {
      "type": "object",
      "properties": {
        "username_password": {
          "type": "object",
          "required": ["username_env", "password_env"],
          "properties": {
            "username_env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
            "password_env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["kind", "dedicated_test_environment_confirmed"],
      "properties": {
        "kind": { "const": "dedicated_test" },
        "dedicated_test_environment_confirmed": { "const": true }
      },
      "additionalProperties": false
    },
    "execution_policy": {
      "type": "object",
      "required": ["probe_unsupported", "allow_mutations"],
      "properties": {
        "probe_unsupported": { "type": "boolean", "default": true },
        "allow_mutations": { "type": "boolean", "default": false },
        "encodings": {
          "type": "array",
          "items": { "type": "string", "enum": ["TTLV", "JSON", "XML"] }
        },
        "api_levels": {
          "type": "array",
          "items": { "type": "string", "enum": ["high-level", "typed-protocol", "generic-ttlv"] }
        },
        "cleanup_on_failure": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "transport": { "const": "raw_tls" } } },
      "then": { "properties": { "endpoints": { "required": ["raw_tls"] } } }
    },
    {
      "if": { "properties": { "transport": { "const": "https" } } },
      "then": { "properties": { "endpoints": { "required": ["https"] } } }
    }
  ]
}
